{
  "name": "testportal-gpt",
  "displayName": "AntiTestportal GPT (with Moodle support)",
  "version": "2.11.2",
  "description": "Solve Testportal and Moodle exams automatically using AI!",
  "author": "Daniel Rogowski",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "plasmo": "0.90.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-toastify": "^11.1.0",
    "use-async-effect": "^2.2.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/chrome": "0.2.8",
    "@types/node": "26.4.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "manifest": {
    "web_accessible_resources": [
      {
        "resources": [
          "assets/anti-anti-tamper.js"
        ],
        "matches": [
          "*://*/*"
        ]
      }
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "background": {
      "service_worker": "src/background.ts"
    }
  }
}
